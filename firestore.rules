rules_version = '2';

// Multi-tenant isolation (design D3). A caller's scope lives in
// memberships/{uid}: either association scope (sees every school whose
// associationId matches) or school scope (sees only the schools listed in
// schoolIds). Every descendant document carries a denormalized `schoolId`
// (and `associationId` where relevant) so access can be decided by comparing
// fields, with a single get() to resolve a school's association when needed.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath() {
      return /databases/$(database)/documents/memberships/$(request.auth.uid);
    }

    function hasMembership() {
      return isSignedIn() && exists(membershipPath());
    }

    function membership() {
      return get(membershipPath()).data;
    }

    // True when the caller's membership covers `schoolId`. School-scope users
    // match directly against their schoolIds; association-scope users match
    // when the school belongs to their association (resolved via a lookup).
    function canAccessSchool(schoolId) {
      return hasMembership() && (
        (membership().scope == 'school' &&
          membership().schoolIds.hasAny([schoolId])) ||
        (membership().scope == 'association' &&
          get(/databases/$(database)/documents/schools/$(schoolId)).data.associationId
            == membership().associationId)
      );
    }

    // School documents are keyed by schoolId; their association is a field, so
    // access is decided without an extra lookup (works for create too).
    function canAccessSchoolDoc(schoolId, data) {
      return hasMembership() && (
        (membership().scope == 'school' &&
          membership().schoolIds.hasAny([schoolId])) ||
        (membership().scope == 'association' &&
          data.associationId == membership().associationId)
      );
    }

    // A user may read only their own membership document; memberships are
    // assigned out-of-band (admin/seed), never written by the client.
    match /memberships/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /associations/{associationId} {
      allow read, write: if hasMembership() &&
        membership().scope == 'association' &&
        membership().associationId == associationId;
    }

    // Schools belong to an association, so only association scope creates or
    // deletes them. A school-scope user matches on the doc id alone and could
    // otherwise delete its school and recreate it under another association.
    function isAssociationOwnerOf(data) {
      return hasMembership() &&
        membership().scope == 'association' &&
        data.associationId == membership().associationId;
    }

    match /schools/{schoolId} {
      allow read: if canAccessSchoolDoc(schoolId, resource.data);
      allow delete: if isAssociationOwnerOf(resource.data);
      allow create: if isAssociationOwnerOf(request.resource.data);
      // A school never changes association: a school-scope user would
      // otherwise pass both checks (they match on the doc id) while moving it.
      allow update: if canAccessSchoolDoc(schoolId, resource.data) &&
        canAccessSchoolDoc(schoolId, request.resource.data) &&
        request.resource.data.associationId == resource.data.associationId;
    }

    // A sede's denormalized associationId must be its parent school's, so the
    // stored hierarchy stays consistent for anything that later reads it.
    function matchesSchoolAssociation(data) {
      return data.associationId ==
        get(/databases/$(database)/documents/schools/$(data.schoolId)).data.associationId;
    }

    // All remaining tenant collections carry a `schoolId` field and are scoped
    // uniformly. Writes must both target and originate within the caller's
    // scope (checked against resource.data and request.resource.data).
    match /sedes/{id} {
      allow read, delete: if canAccessSchool(resource.data.schoolId);
      allow create: if canAccessSchool(request.resource.data.schoolId) &&
        matchesSchoolAssociation(request.resource.data);
      allow update: if canAccessSchool(resource.data.schoolId) &&
        canAccessSchool(request.resource.data.schoolId) &&
        matchesSchoolAssociation(request.resource.data);
    }

    match /students/{id} {
      allow read, delete: if canAccessSchool(resource.data.schoolId);
      allow create: if canAccessSchool(request.resource.data.schoolId) &&
        matchesSchoolAssociation(request.resource.data);
      allow update: if canAccessSchool(resource.data.schoolId) &&
        canAccessSchool(request.resource.data.schoolId) &&
        matchesSchoolAssociation(request.resource.data);
    }

    match /studentGroups/{id} {
      allow read, delete: if canAccessSchool(resource.data.schoolId);
      allow create: if canAccessSchool(request.resource.data.schoolId);
      allow update: if canAccessSchool(resource.data.schoolId) &&
        canAccessSchool(request.resource.data.schoolId);
    }

    // A class hangs from a sede of its own school and carries that school's
    // association; it never moves to another school.
    function isSedeOfSchool(data) {
      return get(/databases/$(database)/documents/sedes/$(data.sedeId)).data.schoolId == data.schoolId;
    }

    match /classes/{id} {
      allow read, delete: if canAccessSchool(resource.data.schoolId);
      allow create: if canAccessSchool(request.resource.data.schoolId) &&
        matchesSchoolAssociation(request.resource.data) &&
        isSedeOfSchool(request.resource.data);
      // The sede is re-checked only when it changes, so a class can still be
      // edited or deactivated if its sede was removed outside the app.
      allow update: if canAccessSchool(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId &&
        matchesSchoolAssociation(request.resource.data) &&
        (request.resource.data.sedeId == resource.data.sedeId ||
          isSedeOfSchool(request.resource.data));
    }

    // An enrollment joins a class and a student of the same school (the
    // enrollment's), under the deterministic id `${classId}_${studentId}` so
    // enrolling twice rewrites the same document.
    function isValidEnrollment(id, data) {
      return id == data.classId + '_' + data.studentId &&
        get(/databases/$(database)/documents/classes/$(data.classId)).data.schoolId == data.schoolId &&
        get(/databases/$(database)/documents/students/$(data.studentId)).data.schoolId == data.schoolId;
    }

    match /classEnrollments/{id} {
      allow read, delete: if canAccessSchool(resource.data.schoolId);
      allow create: if canAccessSchool(request.resource.data.schoolId) &&
        isValidEnrollment(id, request.resource.data);
      allow update: if canAccessSchool(resource.data.schoolId) &&
        canAccessSchool(request.resource.data.schoolId) &&
        isValidEnrollment(id, request.resource.data);
    }

    // One record per class, student and date, under the deterministic id
    // `${classId}_${studentId}_${date}` so re-marking a day rewrites it. Only
    // the class is looked up (the same document for a whole class, so a
    // batch stays within the rules access-call limit); the app offers only
    // enrolled students.
    function isAttendanceShape(id, data) {
      return data.classId is string && data.studentId is string &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.present is bool &&
        id == data.classId + '_' + data.studentId + '_' + data.date;
    }

    match /attendance/{id} {
      allow read, delete: if canAccessSchool(resource.data.schoolId);
      allow create: if canAccessSchool(request.resource.data.schoolId) &&
        isAttendanceShape(id, request.resource.data) &&
        get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.schoolId
          == request.resource.data.schoolId;
      // An update changes only the mark; the keys fixed by the id stay put.
      allow update: if canAccessSchool(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.classId == resource.data.classId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.date == resource.data.date &&
        isAttendanceShape(id, request.resource.data);
    }

    function isPaymentShape(id, data) {
      return data.studentId is string &&
        data.period is string && data.period.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.amount is number && data.amount > 0 &&
        data.status == 'paid' && data.method == 'cash' &&
        data.paidAt is string &&
        id == data.studentId + '_' + data.period;
    }

    // One cuota per student and period: a payment is created once and never
    // updated, so a paid period cannot be paid again or overwritten.
    match /payments/{id} {
      allow read, delete: if canAccessSchool(resource.data.schoolId);
      allow create: if canAccessSchool(request.resource.data.schoolId) &&
        isPaymentShape(id, request.resource.data) &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.schoolId
          == request.resource.data.schoolId;
      allow update: if false;
    }

    match /events/{id} {
      allow read, delete: if canAccessSchool(resource.data.schoolId);
      allow create: if canAccessSchool(request.resource.data.schoolId);
      allow update: if canAccessSchool(resource.data.schoolId) &&
        canAccessSchool(request.resource.data.schoolId);
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
