  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects app",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tkd \"jest --selectProjects rules --runInBand\"",
    "test:auth": "firebase emulators:exec --only auth,firestore --project demo-tkd \"jest --selectProjects auth --runInBand\"",
    "emulators": "firebase emulators:start --project demo-tkd",
